<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BBEntropyEffectMinimalRepro</AssemblyName>
    <Product>BBEntropyEffect Minimal JS Dump Repro</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>BBEntropyEffectMinimalRepro</RootNamespace>

    <!--
      Directory containing the game's IL2CPP interop assemblies.
      Put Assembly-CSharp.dll, UnityEngine*.dll, Il2Cppmscorlib.dll,
      NOAH.Core.Runtime.dll and com.tencent.puerts.core.dll there.
      Override with: dotnet build -p:DllsDir=/path/to/dlls
    -->
    <DllsDir Condition="'$(DllsDir)' == ''">dlls</DllsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.793" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(DllsDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(DllsDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(DllsDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(DllsDir)/Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NOAH.Core.Runtime">
      <HintPath>$(DllsDir)/NOAH.Core.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.tencent.puerts.core">
      <HintPath>$(DllsDir)/com.tencent.puerts.core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
